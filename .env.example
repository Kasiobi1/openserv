# Verifier key: signs VerificationReports. Holds no funds. Never given to provider agents.
VERIFIER_PRIVATE_KEY=

# Signer key: the ONLY key that can call release()/refundAndSlash(). Used once the escrow contract is wired in.
SIGNER_PRIVATE_KEY=

# Policy (token amounts in smallest units; mock ERC-20 assumed 6 decimals)
TOKEN_DECIMALS=6
MAX_SPEND_PER_JOB=1000000000
MIN_PROVIDER_SCORE=300
SLASH_BPS=3000
REPORT_MAX_AGE_SECONDS=900
PORT=8787

# Reasoning: mock | serv | openai-compatible. serv defaults the base URL to https://inference-api.openserv.ai/v1
# (per the brief); API access, pricing and model name are unconfirmed, so KEY and MODEL are required.
REASONING_PROVIDER=mock
REASONING_BASE_URL=
REASONING_API_KEY=
REASONING_MODEL=

# Payment rail on the settlement path. Only x402 (demo, x402-style) is implemented; ap2/mpp/stablecoin are placeholders.
RAIL=x402
RAIL_NETWORK=base-sepolia
RAIL_ASSET=mock-erc20
# Escrow contract address; zero address is a placeholder until the contract is deployed.
RAIL_PAY_TO=0x0000000000000000000000000000000000000000

# Semantic audit (verifier layer 2, used for jobs with verificationTier "auditor")
AUDIT_MAX_ITEMS=50
AUDIT_MAX_CHARS=60000
AUDIT_MIN_CONFIDENCE=0.8

# Chain. Leave ESCROW_ADDRESS empty to use the in-memory mock escrow.
# CHAIN_NAME: base-sepolia | sepolia | foundry (local anvil). Fill ESCROW/TOKEN from `npm run deploy -w backend` output.
CHAIN_NAME=
CHAIN_RPC_URL=
ESCROW_ADDRESS=
TOKEN_ADDRESS=

# Deploy script only (never needed by the running backend)
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=

# Demo wallets (npm run wallets -w backend generates them). Testnet only; each needs a little ETH for gas.
BUYER_PRIVATE_KEY=
HONEST_PRIVATE_KEY=
FAULTY_PRIVATE_KEY=
# Where the running backend listens (defaults to http://localhost:PORT)
BACKEND_URL=

# Automatic verify + settle after every submission. Leave false for the scripted backend demo; true for agents / hosting.
AUTO_PIPELINE=false
# Comma-separated dashboard origins allowed by CORS (leave blank to allow any; data is read-only demo data).
DASHBOARD_ORIGIN=
# Shown in the dashboard next to amounts.
TOKEN_SYMBOL=mUSD

# Persistence. Leave both blank to use the in-memory store (lost on every restart).
# Create a project at supabase.com, run supabase/migrations/0001_init.sql in its SQL Editor,
# then fill these from Project Settings -> API. Use the SECRET key here, never the publishable one.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
